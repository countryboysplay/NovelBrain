{
  "name": "novel-brain",
  "productName": "Novel Brain",
  "version": "0.1.0",
  "description": "A studio where Claude Code writes novels",
  "main": "out/main/index.js",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "smoke": "npm run build:hooks && electron-vite build && playwright test test/smoke.spec.ts test/run.spec.ts test/studio.spec.ts test/a11y.spec.ts test/publish.spec.ts",
    "dist": "npm run build:hooks && electron-vite build && electron-builder --win --publish never",
    "release": "npm run build:hooks && electron-vite build && electron-builder --win --publish always",
    "build:hooks": "node scripts/build-hooks.mjs",
    "test:kit": "node --test kit/test/check-skills.test.mjs kit/test/check-kit.test.mjs",
    "assets:export": "node scripts/export-assets.mjs"
  },
  "dependencies": {
    "@lydell/node-pty": "^1.2.0-beta.15",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "@fontsource/crimson-pro": "5.3.0",
    "@fontsource/eb-garamond": "5.3.0",
    "@fontsource/libre-baskerville": "5.3.0",
    "@fontsource/opendyslexic": "^5.3.0",
    "@fontsource/permanent-marker": "^5.3.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.2",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^5.2.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "axe-core": "^4.14.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "esbuild": "^0.28.2",
    "pagedjs": "0.4.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "vitest": "^5.0.1"
  }
}
